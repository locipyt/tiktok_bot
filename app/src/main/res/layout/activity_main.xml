<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A0B2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LociBot"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/tabAgentBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="Агент"
            android:backgroundTint="#2196F3"/>
        <Button
            android:id="@+id/tabTikTokBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="Тикток Бот"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E91E63"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAgent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">
        <EditText
            android:id="@+id/editTextCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Команда (Открой YouTube)..."
            android:textColorHint="#A0A0A0"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="16dp"/>
        <Button
            android:id="@+id/btnExecute"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Выполнить"
            android:backgroundTint="#2196F3"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTikTok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText
            android:id="@+id/editTextComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Текст комментария..."
            android:textColorHint="#A0A0A0"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E91E63"
            android:layout_marginBottom="12dp"/>
        <Button
            android:id="@+id/btnStartTikTok"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Включить плавающее окно"
            android:backgroundTint="#E91E63"/>
    </LinearLayout>
</LinearLayout>
